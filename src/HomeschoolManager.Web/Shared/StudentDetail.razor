@using Microsoft.AspNetCore.Components

<div class="student-detail">
    @if (Student != null)
    {
        <div class="row">
            <!-- Student Profile -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">Student Profile</h6>
                    </div>
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <div class="avatar-placeholder bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
                                @Student.FirstName.Substring(0, 1)
                            </div>
                        </div>
                        <h5>@Student.FirstName @Student.LastName</h5>
                        <p class="text-muted">Grade @Student.GradeLevel • @CalculateAge(Student.DateOfBirth) years old</p>
                        <div class="row text-center">
                            <div class="col-6">
                                <h4 class="text-primary">@Student.GPA.ToString("F1")</h4>
                                <small class="text-muted">GPA</small>
                            </div>
                            <div class="col-6">
                                <h4 class="text-success">@Student.TotalCredits</h4>
                                <small class="text-muted">Credits</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Academic Summary -->
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">Academic Summary</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Personal Information</h6>
                                <table class="table table-sm">
                                    <tr><td><strong>Email:</strong></td><td>@Student.Email</td></tr>
                                    <tr><td><strong>Birth Date:</strong></td><td>@Student.DateOfBirth.ToString("MM/dd/yyyy")</td></tr>
                                    <tr><td><strong>Enrollment:</strong></td><td>@Student.EnrollmentDate.ToString("MM/dd/yyyy")</td></tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <h6>Courses</h6>
                                <div class="mb-2">
                                    @foreach (var course in Student.Courses)
                                    {
                                        <span class="badge bg-primary me-1 mb-1">@course.Name</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Grades and Assignments -->
        <div class="row mt-3">
            <!-- Recent Grades -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">Recent Grades</h6>
                        <button class="btn btn-sm btn-outline-primary" @onclick="ViewAllGrades">
                            View All
                        </button>
                    </div>
                    <div class="card-body">
                        @if (Grades.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Subject</th>
                                            <th>Assignment</th>
                                            <th>Grade</th>
                                            <th>Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var grade in Grades.Take(5))
                                        {
                                            <tr>
                                                <td>@grade.Subject</td>
                                                <td>@grade.Assignment</td>
                                                <td><span class="badge bg-@GetGradeColor(grade.GradeValue)">@grade.GradeValue</span></td>
                                                <td>@grade.Date.ToString("MM/dd")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center">No recent grades available.</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Pending Assignments -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">Pending Assignments</h6>
                        <button class="btn btn-sm btn-outline-success" @onclick="ViewAllAssignments">
                            View All
                        </button>
                    </div>
                    <div class="card-body">
                        @if (Assignments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Subject</th>
                                            <th>Assignment</th>
                                            <th>Due Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var assignment in Assignments.Take(5))
                                        {
                                            <tr>
                                                <td>@assignment.Subject</td>
                                                <td>@assignment.Title</td>
                                                <td>@assignment.DueDate.ToString("MM/dd")</td>
                                                <td><span class="badge bg-@GetStatusColor(assignment.Status)">@assignment.Status</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center">No pending assignments.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Progress Charts -->
        <div class="row mt-3">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">Subject Performance</h6>
                    </div>
                    <div class="card-body">
                        @foreach (var course in Student.Courses)
                        {
                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <span>@course.Name</span>
                                    <span>@GetSubjectGrade(course.Name)</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-@GetSubjectColor(course.Name)" style="width: @GetSubjectProgress(course.Name)%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">Quick Actions</h6>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-primary btn-sm" @onclick="() => OnAddGrade.InvokeAsync(Student)">
                                <span class="oi oi-plus"></span> Add Grade
                            </button>
                            <button class="btn btn-outline-success btn-sm" @onclick="() => OnAddAssignment.InvokeAsync(Student)">
                                <span class="oi oi-plus"></span> Add Assignment
                            </button>
                            <button class="btn btn-outline-info btn-sm" @onclick="() => OnViewReport.InvokeAsync(Student)">
                                <span class="oi oi-document"></span> Generate Report
                            </button>
                            <button class="btn btn-outline-warning btn-sm" @onclick="() => OnEditStudent.InvokeAsync(Student)">
                                <span class="oi oi-pencil"></span> Edit Profile
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center">
                <h5 class="text-muted">No Student Selected</h5>
                <p class="text-muted">Please select a student to view their details.</p>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Student? Student { get; set; }
    [Parameter] public List<Grade> Grades { get; set; } = new();
    [Parameter] public List<Assignment> Assignments { get; set; } = new();
    
    [Parameter] public EventCallback<Student> OnAddGrade { get; set; }
    [Parameter] public EventCallback<Student> OnAddAssignment { get; set; }
    [Parameter] public EventCallback<Student> OnViewReport { get; set; }
    [Parameter] public EventCallback<Student> OnEditStudent { get; set; }

    private string GetGradeColor(string grade)
    {
        return grade switch
        {
            "A" or "A+" => "success",
            "B" or "B+" => "info",
            "C" or "C+" => "warning",
            _ => "danger"
        };
    }

    private int CalculateAge(DateTime dateOfBirth)
    {
        var today = DateTime.Today;
        var age = today.Year - dateOfBirth.Year;
        if (dateOfBirth.Date > today.AddYears(-age)) age--;
        return age;
    }

    private string GetStatusColor(AssignmentStatus status)
    {
        return status switch
        {
            AssignmentStatus.Completed => "success",
            AssignmentStatus.InProgress => "warning",
            AssignmentStatus.Assigned => "secondary",
            AssignmentStatus.Overdue => "danger",
            _ => "secondary"
        };
    }

    private string GetSubjectGrade(string subject)
    {
        var subjectGrades = Grades.Where(g => g.Subject == subject).ToList();
        if (!subjectGrades.Any()) return "N/A";
        
        var averageGrade = subjectGrades.Average(g => GetGradeValue(g.GradeValue));
        return GetGradeFromValue(averageGrade);
    }

    private int GetSubjectProgress(string subject)
    {
        var subjectGrades = Grades.Where(g => g.Subject == subject).ToList();
        if (!subjectGrades.Any()) return 0;
        
        var averageGrade = subjectGrades.Average(g => GetGradeValue(g.GradeValue));
        return (int)((averageGrade / 4.0) * 100); // Assuming 4.0 is max GPA
    }

    private string GetSubjectColor(string subject)
    {
        var progress = GetSubjectProgress(subject);
        return progress switch
        {
            >= 90 => "success",
            >= 80 => "info",
            >= 70 => "warning",
            _ => "danger"
        };
    }

    private double GetGradeValue(string grade)
    {
        return grade switch
        {
            "A+" => 4.0,
            "A" => 4.0,
            "A-" => 3.7,
            "B+" => 3.3,
            "B" => 3.0,
            "B-" => 2.7,
            "C+" => 2.3,
            "C" => 2.0,
            "C-" => 1.7,
            "D+" => 1.3,
            "D" => 1.0,
            "F" => 0.0,
            _ => 0.0
        };
    }

    private string GetGradeFromValue(double value)
    {
        return value switch
        {
            >= 3.7 => "A",
            >= 3.3 => "B+",
            >= 3.0 => "B",
            >= 2.7 => "B-",
            >= 2.3 => "C+",
            >= 2.0 => "C",
            >= 1.7 => "C-",
            >= 1.3 => "D+",
            >= 1.0 => "D",
            _ => "F"
        };
    }

    private void ViewAllGrades()
    {
        // Implementation for viewing all grades
    }

    private void ViewAllAssignments()
    {
        // Implementation for viewing all assignments
    }
} 