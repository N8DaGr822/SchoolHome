@page "/"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Dashboard - Homeschool Manager</PageTitle>

<div class="container-fluid">
    <h1>Homeschool Dashboard</h1>
    
    <div class="row">
        <div class="col-md-2">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Students</h5>
                    <p class="card-text">Manage your homeschool students</p>
                    <a href="students" class="btn btn-primary">View Students</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-2">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Courses</h5>
                    <p class="card-text">Organize your curriculum</p>
                    <a href="courses" class="btn btn-primary">View Courses</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-2">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Assignments</h5>
                    <p class="card-text">Track homework and projects</p>
                    <a href="assignments" class="btn btn-primary">View Assignments</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-2">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Resources</h5>
                    <p class="card-text">Access teaching materials and tools</p>
                    <a href="resources" class="btn btn-primary">View Resources</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-2">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Teach</h5>
                    <p class="card-text">Track teaching time and grade assignments</p>
                    <a href="teach" class="btn btn-success">Start Teaching</a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            <div class="alert alert-info">
                <h4>Welcome to Homeschool Manager</h4>
                <p>This application helps you manage your homeschool curriculum, track student progress, and organize assignments.</p>
            </div>
        </div>
    </div>
</div> 