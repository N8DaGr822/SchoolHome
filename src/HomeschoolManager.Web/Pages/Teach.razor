@page "/teach"
@using HomeschoolManager.Application.Services
@using HomeschoolManager.Core.Entities
@inject IStudentService StudentService
@inject ICourseService CourseService
@inject IAssignmentService AssignmentService

<PageTitle>Teach - Homeschool Manager</PageTitle>

<div class="container-fluid">
    <h1>Teaching Dashboard</h1>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <a class="btn btn-primary w-100 mb-2" href="#session-tracker">
                                <span class="oi oi-play-circle"></span> Teaching Session
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a class="btn btn-success w-100 mb-2" href="#grading-section">
                                <span class="oi oi-check"></span> Grade Assignments
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a class="btn btn-info w-100 mb-2" href="#progress-section">
                                <span class="oi oi-bar-chart"></span> View Progress
                            </a>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-warning w-100 mb-2" @onclick="GenerateReport">
                                <span class="oi oi-document"></span> Generate Report
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (generatedReport is not null)
    {
        <div class="row mb-4" id="report-section">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <h5 class="mb-0">Progress Report</h5>
                            <small class="text-muted">Generated @generatedReport.GeneratedAt.ToString("MM/dd/yyyy h:mm tt")</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearReport">
                            Close
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="row text-center mb-4">
                            <div class="col-6 col-md-3 mb-3 mb-md-0">
                                <h4 class="text-primary">@generatedReport.StudentCount</h4>
                                <small class="text-muted">Students</small>
                            </div>
                            <div class="col-6 col-md-3 mb-3 mb-md-0">
                                <h4 class="text-info">@generatedReport.CourseCount</h4>
                                <small class="text-muted">Courses</small>
                            </div>
                            <div class="col-6 col-md-3">
                                <h4 class="text-warning">@generatedReport.OpenAssignments</h4>
                                <small class="text-muted">Open Assignments</small>
                            </div>
                            <div class="col-6 col-md-3">
                                <h4 class="text-success">@generatedReport.CompletedAssignments</h4>
                                <small class="text-muted">Completed Assignments</small>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-lg-8">
                                <h6>Student Workload</h6>
                                @if (generatedReport.Students.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle">
                                            <thead>
                                                <tr>
                                                    <th>Student</th>
                                                    <th>Grade</th>
                                                    <th>Subjects</th>
                                                    <th>Open</th>
                                                    <th>Completed</th>
                                                    <th>Next Due</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in generatedReport.Students)
                                                {
                                                    <tr>
                                                        <td>@row.StudentName</td>
                                                        <td>@row.GradeLevel</td>
                                                        <td>@row.Subjects</td>
                                                        <td>@row.OpenAssignments</td>
                                                        <td>@row.CompletedAssignments</td>
                                                        <td>@(row.NextDueDate?.ToString("MM/dd/yyyy") ?? "-")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">No students available.</p>
                                }
                            </div>

                            <div class="col-lg-4">
                                <h6>Subject Summary</h6>
                                @if (generatedReport.Subjects.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Subject</th>
                                                    <th>Open</th>
                                                    <th>Completed</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in generatedReport.Subjects)
                                                {
                                                    <tr>
                                                        <td>@row.Subject</td>
                                                        <td>@row.OpenAssignments</td>
                                                        <td>@row.CompletedAssignments</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">No assignment subjects available.</p>
                                }
                            </div>
                        </div>

                        <hr />

                        <div class="row">
                            <div class="col-md-6">
                                <h6>Session Summary</h6>
                                <p class="mb-1"><strong>@generatedReport.SessionHours.ToString("F1")</strong> hours tracked in this browser session.</p>
                                @if (generatedReport.RecentSessions.Any())
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var session in generatedReport.RecentSessions)
                                        {
                                            <li>@session.Student, @session.Subject, @session.Duration on @session.Date.ToString("MM/dd/yyyy")</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">No teaching sessions tracked in this browser session.</p>
                                }
                            </div>
                            <div class="col-md-6">
                                <h6>Focus Areas</h6>
                                @if (generatedReport.FocusAreas.Any())
                                {
                                    <ul class="mb-0">
                                        @foreach (var item in generatedReport.FocusAreas)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">No overdue or open assignment focus areas found.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-6" id="session-tracker">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Teaching Session Tracker</h5>
                </div>
                <div class="card-body">
                    @if (isTeachingSessionActive)
                    {
                        <div class="alert alert-success">
                            <h6>Active Session</h6>
                            <p>Teaching: @currentSubject with @currentStudent</p>
                            <p>Started: @sessionStartTime.ToString("HH:mm")</p>
                            <p>Duration: @GetSessionDuration()</p>
                            <button class="btn btn-danger" @onclick="StopTeachingSession">
                                <span class="oi oi-stop"></span> Stop Session
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label" for="student-select">Select Student</label>
                            <select id="student-select" class="form-select" @bind="selectedStudentId">
                                <option value="0">Choose a student...</option>
                                @foreach (var student in students)
                                {
                                    <option value="@student.Id">@student.FirstName @student.LastName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="subject-select">Select Subject</label>
                            <select id="subject-select" class="form-select" @bind="selectedSubject">
                                <option value="">Choose a subject...</option>
                                @foreach (var subject in subjects)
                                {
                                    <option value="@subject">@subject</option>
                                }
                            </select>
                        </div>
                        <button class="btn btn-primary" @onclick="StartTeachingSession" disabled="@(selectedStudentId == 0 || string.IsNullOrEmpty(selectedSubject))">
                            <span class="oi oi-play-circle"></span> Start Session
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Recent Teaching Sessions</h5>
                </div>
                <div class="card-body">
                    @if (recentSessions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Student</th>
                                        <th>Subject</th>
                                        <th>Duration</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var session in recentSessions.Take(5))
                                    {
                                        <tr>
                                            <td>@session.Student</td>
                                            <td>@session.Subject</td>
                                            <td>@session.Duration</td>
                                            <td>@session.Date.ToString("MM/dd")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No recent sessions. Start teaching to see activity here.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-8" id="grading-section">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Assignment Grading</h5>
                </div>
                <div class="card-body">
                    @if (pendingAssignments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Student</th>
                                        <th>Assignment</th>
                                        <th>Subject</th>
                                        <th>Due Date</th>
                                        <th>Grade</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var assignment in pendingAssignments)
                                    {
                                        <tr>
                                            <td>@GetStudentName(assignment.StudentId)</td>
                                            <td>@assignment.Title</td>
                                            <td>@assignment.Subject</td>
                                            <td>@assignment.DueDate.ToString("MM/dd/yyyy")</td>
                                            <td>
                                                <select class="form-select form-select-sm" value="@GetDraftGrade(assignment.Id)" @onchange="e => SetDraftGrade(assignment.Id, e.Value?.ToString() ?? string.Empty)" style="width: 88px;">
                                                    <option value="">-</option>
                                                    @foreach (var grade in gradeOptions)
                                                    {
                                                        <option value="@grade">@grade</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-success" @onclick="() => SaveGrade(assignment)" disabled="@string.IsNullOrWhiteSpace(GetDraftGrade(assignment.Id))">
                                                    <span class="oi oi-check"></span> Save
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No pending assignments to grade.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4" id="progress-section">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Teaching Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <h4 class="text-primary">@totalTeachingHours.ToString("F1")</h4>
                            <small class="text-muted">Session Hours</small>
                        </div>
                        <div class="col-6">
                            <h4 class="text-success">@completedAssignments</h4>
                            <small class="text-muted">Completed</small>
                        </div>
                    </div>
                    <hr />
                    <h6>Open Work by Subject</h6>
                    @if (subjectWorkload.Any())
                    {
                        @foreach (var item in subjectWorkload)
                        {
                            <div class="mb-2">
                                <div class="d-flex justify-content-between">
                                    <small class="text-muted">@item.Subject</small>
                                    <small class="text-muted">@item.Count</small>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar" style="width: @item.Percent%"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No open assignments.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly List<string> gradeOptions = new()
    {
        "A+", "A", "A-", "B+", "B", "B-", "C+", "C", "C-", "D+", "D", "F"
    };

    private bool isTeachingSessionActive;
    private int selectedStudentId;
    private string selectedSubject = "";
    private string currentStudent = "";
    private string currentSubject = "";
    private DateTime sessionStartTime;
    private double totalTeachingHours;
    private int completedAssignments;
    private string? errorMessage;
    private TeachingReport? generatedReport;

    private List<Student> students = new();
    private List<Course> courses = new();
    private List<string> subjects = new();
    private List<TeachingSession> recentSessions = new();
    private List<Assignment> pendingAssignments = new();
    private List<Assignment> allAssignments = new();
    private Dictionary<int, string> draftGrades = new();

    private IEnumerable<(string Subject, int Count, int Percent)> subjectWorkload
    {
        get
        {
            var groups = pendingAssignments
                .GroupBy(a => string.IsNullOrWhiteSpace(a.Subject) ? "Unassigned" : a.Subject)
                .Select(g => new { Subject = g.Key, Count = g.Count() })
                .OrderByDescending(g => g.Count)
                .ToList();

            var max = groups.Select(g => g.Count).DefaultIfEmpty(1).Max();
            return groups.Select(g => (g.Subject, g.Count, Math.Max(10, (int)Math.Round((double)g.Count / max * 100))));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        errorMessage = null;

        try
        {
            students = (await StudentService.GetAllStudentsAsync()).ToList();
            courses = (await CourseService.GetAllCoursesAsync()).ToList();
            allAssignments = (await AssignmentService.GetAllAssignmentsAsync()).ToList();
            pendingAssignments = allAssignments
                .Where(a => a.Status != AssignmentStatus.Completed)
                .OrderBy(a => a.DueDate)
                .ToList();
            subjects = courses
                .Select(c => c.Subject)
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct()
                .OrderBy(s => s)
                .ToList();
            completedAssignments = allAssignments.Count(a => a.Status == AssignmentStatus.Completed);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void StartTeachingSession()
    {
        var student = students.FirstOrDefault(s => s.Id == selectedStudentId);
        if (student == null || string.IsNullOrWhiteSpace(selectedSubject))
        {
            return;
        }

        isTeachingSessionActive = true;
        currentStudent = $"{student.FirstName} {student.LastName}";
        currentSubject = selectedSubject;
        sessionStartTime = DateTime.Now;
        selectedStudentId = 0;
        selectedSubject = "";
    }

    private void StopTeachingSession()
    {
        if (!isTeachingSessionActive)
        {
            return;
        }

        var duration = DateTime.Now - sessionStartTime;
        recentSessions.Insert(0, new TeachingSession
        {
            Student = currentStudent,
            Subject = currentSubject,
            Duration = FormatDuration(duration),
            Date = DateTime.Now
        });

        totalTeachingHours += duration.TotalHours;
        isTeachingSessionActive = false;
        currentStudent = "";
        currentSubject = "";
    }

    private string GetSessionDuration()
    {
        return isTeachingSessionActive ? FormatDuration(DateTime.Now - sessionStartTime) : "";
    }

    private async Task SaveGrade(Assignment assignment)
    {
        if (string.IsNullOrWhiteSpace(GetDraftGrade(assignment.Id)))
        {
            return;
        }

        assignment.Status = AssignmentStatus.Completed;
        await AssignmentService.UpdateAssignmentAsync(assignment);
        draftGrades.Remove(assignment.Id);
        await LoadDataAsync();
    }

    private void GenerateReport()
    {
        var assignmentRows = allAssignments.ToList();
        var focusAreas = pendingAssignments
            .Where(a => a.DueDate.Date <= DateTime.Today.AddDays(7))
            .OrderBy(a => a.DueDate)
            .Select(a => $"{GetStudentName(a.StudentId)} has {a.Title} due {a.DueDate:MM/dd/yyyy}.")
            .Take(5)
            .ToList();

        generatedReport = new TeachingReport
        {
            GeneratedAt = DateTime.Now,
            StudentCount = students.Count,
            CourseCount = courses.Count,
            OpenAssignments = pendingAssignments.Count,
            CompletedAssignments = completedAssignments,
            SessionHours = totalTeachingHours,
            Students = students
                .Select(student => CreateStudentReportRow(student, assignmentRows))
                .OrderBy(row => row.StudentName)
                .ToList(),
            Subjects = assignmentRows
                .GroupBy(GetAssignmentSubject)
                .Select(group => new SubjectReportRow
                {
                    Subject = group.Key,
                    OpenAssignments = group.Count(a => a.Status != AssignmentStatus.Completed),
                    CompletedAssignments = group.Count(a => a.Status == AssignmentStatus.Completed)
                })
                .OrderByDescending(row => row.OpenAssignments)
                .ThenBy(row => row.Subject)
                .ToList(),
            RecentSessions = recentSessions.Take(5).ToList(),
            FocusAreas = focusAreas
        };
    }

    private void ClearReport()
    {
        generatedReport = null;
    }

    private StudentReportRow CreateStudentReportRow(Student student, List<Assignment> assignments)
    {
        var studentAssignments = assignments.Where(a => a.StudentId == student.Id).ToList();
        var openAssignments = studentAssignments
            .Where(a => a.Status != AssignmentStatus.Completed)
            .OrderBy(a => a.DueDate)
            .ToList();
        var subjects = studentAssignments
            .Select(GetAssignmentSubject)
            .Concat(student.Courses.Select(c => string.IsNullOrWhiteSpace(c.Subject) ? c.Name : c.Subject))
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct()
            .OrderBy(s => s)
            .ToList();

        return new StudentReportRow
        {
            StudentName = $"{student.FirstName} {student.LastName}",
            GradeLevel = student.GradeLevel,
            Subjects = subjects.Any() ? string.Join(", ", subjects) : "-",
            OpenAssignments = openAssignments.Count,
            CompletedAssignments = studentAssignments.Count(a => a.Status == AssignmentStatus.Completed),
            NextDueDate = openAssignments.FirstOrDefault()?.DueDate
        };
    }

    private string GetStudentName(int studentId)
    {
        var student = students.FirstOrDefault(s => s.Id == studentId);
        return student == null ? "Unknown student" : $"{student.FirstName} {student.LastName}";
    }

    private string GetDraftGrade(int assignmentId)
    {
        return draftGrades.TryGetValue(assignmentId, out var grade) ? grade : string.Empty;
    }

    private void SetDraftGrade(int assignmentId, string grade)
    {
        draftGrades[assignmentId] = grade;
    }

    private static string FormatDuration(TimeSpan duration)
    {
        return duration.TotalHours >= 1
            ? $"{duration.TotalHours:F1} hr"
            : $"{Math.Max(1, (int)Math.Round(duration.TotalMinutes))} min";
    }

    private static string GetAssignmentSubject(Assignment assignment)
    {
        return string.IsNullOrWhiteSpace(assignment.Subject) ? "Unassigned" : assignment.Subject;
    }

    public class TeachingSession
    {
        public string Student { get; set; } = "";
        public string Subject { get; set; } = "";
        public string Duration { get; set; } = "";
        public DateTime Date { get; set; }
    }

    private sealed class TeachingReport
    {
        public DateTime GeneratedAt { get; set; }
        public int StudentCount { get; set; }
        public int CourseCount { get; set; }
        public int OpenAssignments { get; set; }
        public int CompletedAssignments { get; set; }
        public double SessionHours { get; set; }
        public List<StudentReportRow> Students { get; set; } = new();
        public List<SubjectReportRow> Subjects { get; set; } = new();
        public List<TeachingSession> RecentSessions { get; set; } = new();
        public List<string> FocusAreas { get; set; } = new();
    }

    private sealed class StudentReportRow
    {
        public string StudentName { get; set; } = "";
        public string GradeLevel { get; set; } = "";
        public string Subjects { get; set; } = "";
        public int OpenAssignments { get; set; }
        public int CompletedAssignments { get; set; }
        public DateTime? NextDueDate { get; set; }
    }

    private sealed class SubjectReportRow
    {
        public string Subject { get; set; } = "";
        public int OpenAssignments { get; set; }
        public int CompletedAssignments { get; set; }
    }
}
