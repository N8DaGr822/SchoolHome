    }

    private void AddNewResource()
    {
        showAddResourceModal = true;
    }

    private void CloseAddResourceModal()
    {
        showAddResourceModal = false;
        newResource = new Resource();
    }

    private void SaveResource()
    {
        if (!string.IsNullOrEmpty(newResource.Name))
        {
            // In a real implementation, this would save the resource to the database
            showAddResourceModal = false;
        }
    }

    private void UploadFile()
    {
        // In a real implementation, this would open a file upload dialog
        // For now, we'll just show a message
        showAddResourceModal = true;
    }

    private void SearchResources()
    {
        // In a real implementation, this would open a search interface
        // For now, we'll just show the add resource modal
        showAddResourceModal = true;
    }

    private void ShareResource()
    {
        // In a real implementation, this would open a sharing dialog
        // For now, we'll just show a message
    }

    private void OpenMathCurriculum()
    {
        // In a real implementation, this would open the Math Curriculum resource
        // For now, we'll just show a message
    }

    private void OpenScienceExperiments()
    {
        // In a real implementation, this would open the Science Experiments resource
        // For now, we'll just show a message
    }

    private void OpenLanguageArts()
    {
        // In a real implementation, this would open the Language Arts resource
        // For now, we'll just show a message
    }

    private void OpenHistoryTimeline()
    {
        // In a real implementation, this would open the History Timeline resource
        // For now, we'll just show a message
    }

    private void OpenResource(string resourceName)
    {
        // In a real implementation, this would open the specific resource
        // For now, we'll just show a message
    }

    // Helper classes
    public class GradeEntry
    {
        public string AssignmentName { get; set; } = "";
        public string GradeValue { get; set; } = "A";
        public int Weight { get; set; } = 10;
        public double Points => GetGradePoints() * Weight / 100.0;

        private double GetGradePoints()
        {
            return GradeValue switch
            {
                "A+" => 4.0,
                "A" => 4.0,
                "A-" => 3.7,
                "B+" => 3.3,
                "B" => 3.0,
                "B-" => 2.7,
                "C+" => 2.3,
                "C" => 2.0,
                "C-" => 1.7,
                "D+" => 1.3,
                "D" => 1.0,
                "F" => 0.0,
                _ => 0.0
            };
        }
    }

    public class Resource
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Category { get; set; } = "";
        public string Url { get; set; } = "";
        public string GradeLevel { get; set; } = "";
