                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">History Timeline</h6>
                                <small class="text-muted">3-8</small>
                            </div>
                            <p class="mb-1">Interactive history timeline and lesson plans</p>
                        </a>
