                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="card-title">Printable Worksheets</h6>
                                    <ul class="list-unstyled">
                                        <li><a href="https://www.education.com/worksheets" target="_blank" class="text-decoration-none">Education.com</a></li>
                                        <li><a href="https://www.superteacherworksheets.com" target="_blank" class="text-decoration-none">Super Teacher Worksheets</a></li>
                                        <li><a href="https://www.math-drills.com" target="_blank" class="text-decoration-none">Math-Drills.com</a></li>
