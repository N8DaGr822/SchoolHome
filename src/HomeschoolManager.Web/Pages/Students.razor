@page "/students"
@using HomeschoolManager.Application.Services
@using HomeschoolManager.Core.Entities
@inject IStudentService StudentService
@inject IJSRuntime JS

<PageTitle>Students - Homeschool Manager</PageTitle>

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="mb-1">Student Management</h1>
            <p class="text-muted mb-0">Track profiles, assignments, and recent grades.</p>
        </div>
        <button class="btn btn-primary" @onclick="ShowAddStudentModal">
            <span class="oi oi-plus"></span> Add Student
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Students (@students.Count)</h5>
                </div>
                <div class="card-body p-0">
                    @if (isLoading)
                    {
                        <p class="text-muted p-3 mb-0">Loading students...</p>
                    }
                    else if (students.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var student in students)
                            {
                                <button class="list-group-item list-group-item-action @(selectedStudent?.Id == student.Id ? "active" : "")"
                                        @onclick="() => SelectStudent(student)">
                                    <div class="d-flex w-100 justify-content-between gap-2">
                                        <h6 class="mb-1">@student.FirstName @student.LastName</h6>
                                        <small>@CalculateAge(student.DateOfBirth) years old</small>
                                    </div>
                                    <p class="mb-1">Grade @student.GradeLevel</p>
                                    <small class="@(selectedStudent?.Id == student.Id ? "text-white-50" : "text-muted")">
                                        @student.Courses.Count courses / @student.Assignments.Count assignments
                                    </small>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-3 text-muted">No students yet.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            @if (selectedStudent != null)
            {
                <div class="card">
                    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h5 class="mb-0">@selectedStudent.FirstName @selectedStudent.LastName's Profile</h5>
                        <div>
                            <button class="btn btn-warning btn-sm me-2" @onclick="() => ShowEditStudentModal(selectedStudent)">
                                <span class="oi oi-pencil"></span> Edit
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteStudent(selectedStudent)">
                                <span class="oi oi-trash"></span> Delete
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Personal Information</h6>
                                <p><strong>Age:</strong> @CalculateAge(selectedStudent.DateOfBirth) years old</p>
                                <p><strong>Grade Level:</strong> @selectedStudent.GradeLevel</p>
                                <p><strong>Birth Date:</strong> @selectedStudent.DateOfBirth.ToString("MM/dd/yyyy")</p>
                                <p><strong>Email:</strong> @(string.IsNullOrWhiteSpace(selectedStudent.Email) ? "Not provided" : selectedStudent.Email)</p>
                            </div>
                            <div class="col-md-6">
                                <h6>Academic Information</h6>
                                <p><strong>GPA:</strong> @selectedStudent.GPA.ToString("F2")</p>
                                <p><strong>Total Credits:</strong> @selectedStudent.TotalCredits</p>
                                <p><strong>Enrollment Date:</strong> @selectedStudent.EnrollmentDate.ToString("MM/dd/yyyy")</p>
                                <p><strong>Last Updated:</strong> @(selectedStudent.UpdatedAt?.ToString("MM/dd/yyyy") ?? "Never")</p>
                            </div>
                        </div>

                        <hr />

                        <h6>Courses</h6>
                        @if (selectedStudent.Courses.Any())
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var course in selectedStudent.Courses)
                                {
                                    <span class="badge bg-primary">@course.Name</span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No courses linked through assignments yet.</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-body text-center">
                        <h5 class="text-muted">Select a Student</h5>
                        <p class="text-muted mb-0">Choose a student from the list to view their details.</p>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (selectedStudent != null)
    {
        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Recent Grades</h5>
                    </div>
                    <div class="card-body">
                        @if (selectedStudentGrades.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Subject</th>
                                            <th>Assignment</th>
                                            <th>Grade</th>
                                            <th>Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var grade in selectedStudentGrades.Take(5))
                                        {
                                            <tr>
                                                <td>@grade.Subject</td>
                                                <td>@grade.Assignment</td>
                                                <td><span class="badge bg-@GetGradeColor(grade.GradeValue)">@grade.GradeValue</span></td>
                                                <td>@GetGradeDate(grade).ToString("MM/dd")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No recent grades available.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Pending Assignments</h5>
                    </div>
                    <div class="card-body">
                        @if (selectedStudentAssignments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Subject</th>
                                            <th>Assignment</th>
                                            <th>Due Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var assignment in selectedStudentAssignments.Take(5))
                                        {
                                            <tr>
                                                <td>@assignment.Subject</td>
                                                <td>@assignment.Title</td>
                                                <td>@assignment.DueDate.ToString("MM/dd")</td>
                                                <td><span class="badge bg-@GetStatusColor(assignment.Status)">@assignment.Status</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No pending assignments.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (showStudentModal)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="@studentForm" OnValidSubmit="SaveStudent">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@(isEditingStudent ? "Edit Student" : "Add New Student")</h5>
                        <button type="button" class="btn-close" @onclick="CloseStudentModal"></button>
                    </div>
                    <div class="modal-body">
                        <ValidationSummary />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" for="first-name">First Name</label>
                                    <InputText id="first-name" class="form-control" @bind-Value="studentForm.FirstName" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" for="last-name">Last Name</label>
                                    <InputText id="last-name" class="form-control" @bind-Value="studentForm.LastName" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" for="email">Email</label>
                                    <InputText id="email" type="email" class="form-control" @bind-Value="studentForm.Email" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" for="grade-level">Grade Level</label>
                                    <InputSelect id="grade-level" class="form-select" @bind-Value="studentForm.GradeLevel">
                                        <option value="">Select Grade</option>
                                        @foreach (var grade in availableGradeLevels)
                                        {
                                            <option value="@grade">@grade Grade</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" for="date-of-birth">Date of Birth</label>
                                    <InputDate id="date-of-birth" class="form-control" @bind-Value="studentForm.DateOfBirth" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" for="gpa">GPA</label>
                                    <InputNumber id="gpa" class="form-control" @bind-Value="studentForm.GPA" />
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="total-credits">Total Credits</label>
                            <InputNumber id="total-credits" class="form-control" @bind-Value="studentForm.TotalCredits" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseStudentModal">Cancel</button>
                        <button type="submit" class="btn btn-primary">@(isEditingStudent ? "Save Changes" : "Add Student")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private readonly List<string> availableGradeLevels = new()
    {
        "K", "1st", "2nd", "3rd", "4th", "5th", "6th",
        "7th", "8th", "9th", "10th", "11th", "12th"
    };

    private List<Student> students = new();
    private Student? selectedStudent;
    private List<Grade> selectedStudentGrades = new();
    private List<Assignment> selectedStudentAssignments = new();
    private Student studentForm = CreateDefaultStudent();
    private bool isLoading = true;
    private bool showStudentModal;
    private bool isEditingStudent;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadStudentsAsync();
    }

    private async Task LoadStudentsAsync(int? preferredStudentId = null)
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            students = (await StudentService.GetAllStudentsAsync()).ToList();
            selectedStudent = preferredStudentId.HasValue
                ? students.FirstOrDefault(s => s.Id == preferredStudentId.Value) ?? students.FirstOrDefault()
                : selectedStudent == null ? students.FirstOrDefault() : students.FirstOrDefault(s => s.Id == selectedStudent.Id) ?? students.FirstOrDefault();

            if (selectedStudent != null)
            {
                await LoadStudentDataAsync(selectedStudent.Id);
            }
            else
            {
                selectedStudentGrades.Clear();
                selectedStudentAssignments.Clear();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectStudent(Student student)
    {
        selectedStudent = student;
        await LoadStudentDataAsync(student.Id);
    }

    private async Task LoadStudentDataAsync(int studentId)
    {
        selectedStudent = await StudentService.GetStudentByIdAsync(studentId);
        selectedStudentGrades = (await StudentService.GetStudentGradesAsync(studentId))
            .OrderByDescending(GetGradeDate)
            .ToList();
        selectedStudentAssignments = (await StudentService.GetStudentAssignmentsAsync(studentId))
            .Where(a => a.Status != AssignmentStatus.Completed)
            .OrderBy(a => a.DueDate)
            .ToList();
    }

    private void ShowAddStudentModal()
    {
        studentForm = CreateDefaultStudent();
        isEditingStudent = false;
        showStudentModal = true;
    }

    private void ShowEditStudentModal(Student student)
    {
        studentForm = CloneStudent(student);
        isEditingStudent = true;
        showStudentModal = true;
    }

    private void CloseStudentModal()
    {
        showStudentModal = false;
    }

    private async Task SaveStudent()
    {
        var savedStudent = isEditingStudent
            ? await StudentService.UpdateStudentAsync(studentForm)
            : await StudentService.CreateStudentAsync(studentForm);

        showStudentModal = false;
        await LoadStudentsAsync(savedStudent.Id);
    }

    private async Task DeleteStudent(Student student)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete {student.FirstName} {student.LastName}? This will also remove their assignments and grades.");
        if (!confirmed)
        {
            return;
        }

        await StudentService.DeleteStudentAsync(student.Id);
        selectedStudent = null;
        await LoadStudentsAsync();
    }

    private static Student CreateDefaultStudent()
    {
        return new Student
        {
            DateOfBirth = DateTime.Today.AddYears(-6),
            EnrollmentDate = DateTime.Today,
            CreatedAt = DateTime.UtcNow
        };
    }

    private static Student CloneStudent(Student student)
    {
        return new Student
        {
            Id = student.Id,
            FirstName = student.FirstName,
            LastName = student.LastName,
            Email = student.Email,
            DateOfBirth = student.DateOfBirth,
            GradeLevel = student.GradeLevel,
            GPA = student.GPA,
            TotalCredits = student.TotalCredits,
            EnrollmentDate = student.EnrollmentDate,
            CreatedAt = student.CreatedAt,
            UpdatedAt = student.UpdatedAt
        };
    }

    private static int CalculateAge(DateTime dateOfBirth)
    {
        var today = DateTime.Today;
        var age = today.Year - dateOfBirth.Year;
        if (dateOfBirth.Date > today.AddYears(-age))
        {
            age--;
        }

        return age;
    }

    private static DateTime GetGradeDate(Grade grade)
    {
        return grade.Date == default ? grade.GradedDate : grade.Date;
    }

    private static string GetGradeColor(string grade)
    {
        return grade switch
        {
            "A" or "A+" or "A-" => "success",
            "B" or "B+" or "B-" => "info",
            "C" or "C+" or "C-" => "warning",
            _ => "danger"
        };
    }

    private static string GetStatusColor(AssignmentStatus status)
    {
        return status switch
        {
            AssignmentStatus.Completed => "success",
            AssignmentStatus.InProgress => "warning",
            AssignmentStatus.Assigned => "secondary",
            AssignmentStatus.Overdue => "danger",
            _ => "secondary"
        };
    }
}
