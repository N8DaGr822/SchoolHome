@page "/courses"
@using Microsoft.AspNetCore.Components
@using HomeschoolManager.Core.Entities

<PageTitle>Courses - Homeschool Manager</PageTitle>

<div class="container-fluid">
    <h1>Course Management</h1>
    
    <!-- Search and Filter Controls -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text">
                    <span class="oi oi-magnifying-glass"></span>
                </span>
                <input type="text" class="form-control" placeholder="Search courses..." @bind="searchTerm" @bind:event="oninput" />
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex gap-2">
                <select class="form-select" @bind="selectedSubject">
                    <option value="">All Subjects</option>
                    @foreach (var subject in availableSubjects)
                    {
                        <option value="@subject">@subject</option>
                    }
                </select>
                <select class="form-select" @bind="selectedGradeLevel">
                    <option value="">All Grades</option>
                    @foreach (var grade in availableGradeLevels)
                    {
                        <option value="@grade">@grade</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- Sort Controls -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-outline-secondary @(sortBy == "Name" ? "active" : "")" @onclick="SortByName">
                    <span class="oi oi-sort-ascending"></span> Name
                </button>
                <button type="button" class="btn btn-outline-secondary @(sortBy == "Subject" ? "active" : "")" @onclick="SortBySubject">
                    <span class="oi oi-sort-ascending"></span> Subject
                </button>
                <button type="button" class="btn btn-outline-secondary @(sortBy == "GradeLevel" ? "active" : "")" @onclick="SortByGradeLevel">
                    <span class="oi oi-sort-ascending"></span> Grade
                </button>
                <button type="button" class="btn btn-outline-secondary @(sortBy == "StartDate" ? "active" : "")" @onclick="SortByStartDate">
                    <span class="oi oi-sort-ascending"></span> Start Date
                </button>
            </div>
            <button type="button" class="btn btn-outline-secondary ms-2" @onclick="ToggleSortDirection">
                <span class="oi @(sortDirection == "asc" ? "oi-sort-ascending" : "oi-sort-descending")"></span>
            </button>
        </div>
    </div>

    <!-- Course List -->
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Courses (@filteredCourses.Count())</h5>
                    <button class="btn btn-primary btn-sm" @onclick="ShowAddCourseModal">
                        <span class="oi oi-plus"></span> Add Course
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var course in filteredCourses)
                        {
                            <button class="list-group-item list-group-item-action @(selectedCourse?.Id == course.Id ? "active" : "")" 
                                    @onclick="() => SelectCourse(course)">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@course.Name</h6>
                                    <small class="badge bg-@(course.IsActive ? "success" : "secondary")">@(course.IsActive ? "Active" : "Inactive")</small>
                                </div>
                                <p class="mb-1">@course.Subject - @course.GradeLevel</p>
                                <small class="text-muted">
                                    @course.LessonPlans.Count lesson plans • 
                                    @course.Assignments.Count assignments
                                </small>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Course Details -->
        <div class="col-md-8">
            @if (selectedCourse != null)
            {
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@selectedCourse.Name</h5>
                        <div>
                            <button class="btn btn-warning btn-sm me-2" @onclick="() => ShowEditCourseModal(selectedCourse)">
                                <span class="oi oi-pencil"></span> Edit
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteCourse(selectedCourse)">
                                <span class="oi oi-trash"></span> Delete
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Course Information</h6>
                                <p><strong>Subject:</strong> @selectedCourse.Subject</p>
                                <p><strong>Grade Level:</strong> @selectedCourse.GradeLevel</p>
                                <p><strong>Start Date:</strong> @selectedCourse.StartDate.ToString("MM/dd/yyyy")</p>
                                <p><strong>End Date:</strong> @(selectedCourse.EndDate?.ToString("MM/dd/yyyy") ?? "Ongoing")</p>
                                <p><strong>Status:</strong> <span class="badge bg-@(selectedCourse.IsActive ? "success" : "secondary")">@(selectedCourse.IsActive ? "Active" : "Inactive")</span></p>
                            </div>
                            <div class="col-md-6">
                                <h6>Statistics</h6>
                                <p><strong>Lesson Plans:</strong> @selectedCourse.LessonPlans.Count</p>
                                <p><strong>Assignments:</strong> @selectedCourse.Assignments.Count</p>
                                <p><strong>Students:</strong> @selectedCourse.Students.Count</p>
                                <p><strong>Created:</strong> @selectedCourse.CreatedAt.ToString("MM/dd/yyyy")</p>
                            </div>
                        </div>
                        
                        <hr />
                        
                        <div class="mb-3">
                            <h6>Description</h6>
                            <p class="text-muted">@selectedCourse.Description</p>
                        </div>
                    </div>
                </div>

                <!-- Lesson Plans Section -->
                <div class="card mt-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Lesson Plans</h5>
                        <button class="btn btn-primary btn-sm" @onclick="ShowAddLessonPlanModal">
                            <span class="oi oi-plus"></span> Add Lesson Plan
                        </button>
                    </div>
                    <div class="card-body">
                        @if (selectedCourse.LessonPlans.Any())
                        {
                            <div class="row">
                                @foreach (var lessonPlan in selectedCourse.LessonPlans.OrderBy(lp => lp.WeekNumber).ThenBy(lp => lp.DayNumber))
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="card h-100">
                                            <div class="card-header d-flex justify-content-between align-items-center">
                                                <h6 class="mb-0">@lessonPlan.Title</h6>
                                                <small class="text-muted">Week @lessonPlan.WeekNumber, Day @lessonPlan.DayNumber</small>
                                            </div>
                                            <div class="card-body">
                                                <p class="card-text">@lessonPlan.Description</p>
                                                <div class="row">
                                                    <div class="col-6">
                                                        <small class="text-muted">
                                                            <strong>Duration:</strong> @lessonPlan.DurationMinutes min
                                                        </small>
                                                    </div>
                                                    <div class="col-6">
                                                        <small class="text-muted">
                                                            <strong>Objectives:</strong> @lessonPlan.Objectives.Split('\n').FirstOrDefault()?.Trim()
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-footer">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => ViewLessonPlan(lessonPlan)">
                                                        <span class="oi oi-eye"></span> View
                                                    </button>
                                                    <button class="btn btn-outline-warning btn-sm" @onclick="() => EditLessonPlan(lessonPlan)">
                                                        <span class="oi oi-pencil"></span> Edit
                                                    </button>
                                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteLessonPlan(lessonPlan)">
                                                        <span class="oi oi-trash"></span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center">No lesson plans available. Click "Add Lesson Plan" to get started.</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-body text-center">
                        <h5 class="text-muted">Select a Course</h5>
                        <p class="text-muted">Choose a course from the list to view its details and lesson plans</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add Course Modal -->
@if (showAddCourseModal)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Course</h5>
                    <button type="button" class="btn-close" @onclick="CloseAddCourseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Course Name</label>
                        <input type="text" class="form-control" @bind="newCourse.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" rows="3" @bind="newCourse.Description"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Subject</label>
                                <select class="form-select" @bind="newCourse.Subject">
                                    <option value="">Select Subject</option>
                                    @foreach (var subject in availableSubjects)
                                    {
                                        <option value="@subject">@subject</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Grade Level</label>
                                <select class="form-select" @bind="newCourse.GradeLevel">
                                    <option value="">Select Grade</option>
                                    @foreach (var grade in availableGradeLevels)
                                    {
                                        <option value="@grade">@grade</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Start Date</label>
                                <input type="date" class="form-control" @bind="newCourse.StartDate" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">End Date (Optional)</label>
                                <input type="date" class="form-control" @bind="newCourse.EndDate" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAddCourseModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="AddCourse">Add Course</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<!-- Add Lesson Plan Modal -->
@if (showAddLessonPlanModal)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Lesson Plan</h5>
                    <button type="button" class="btn-close" @onclick="CloseAddLessonPlanModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Lesson Title</label>
                        <input type="text" class="form-control" @bind="newLessonPlan.Title" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" rows="3" @bind="newLessonPlan.Description"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Week Number</label>
                                <input type="number" class="form-control" @bind="newLessonPlan.WeekNumber" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Day Number</label>
                                <input type="number" class="form-control" @bind="newLessonPlan.DayNumber" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Duration (minutes)</label>
                                <input type="number" class="form-control" @bind="newLessonPlan.DurationMinutes" />
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Learning Objectives</label>
                        <textarea class="form-control" rows="3" @bind="newLessonPlan.Objectives" placeholder="What will students learn?"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Materials Needed</label>
                        <textarea class="form-control" rows="2" @bind="newLessonPlan.Materials" placeholder="Books, supplies, etc."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Activities</label>
                        <textarea class="form-control" rows="3" @bind="newLessonPlan.Activities" placeholder="Step-by-step activities"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Assessment</label>
                        <textarea class="form-control" rows="2" @bind="newLessonPlan.Assessment" placeholder="How will you evaluate learning?"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAddLessonPlanModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="AddLessonPlan">Add Lesson Plan</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<Course> courses = new();
    private Course? selectedCourse;
    private string searchTerm = "";
    private string selectedSubject = "";
    private string selectedGradeLevel = "";
    private string sortBy = "Name";
    private string sortDirection = "asc";
    
    private bool showAddCourseModal = false;
    private bool showAddLessonPlanModal = false;
    private Course newCourse = new();
    private LessonPlan newLessonPlan = new();

    private List<string> availableSubjects = new() { "Math", "Science", "Language Arts", "History", "Geography", "Art", "Music", "Physical Education", "Computer Science" };
    private List<string> availableGradeLevels = new() { "K", "1st", "2nd", "3rd", "4th", "5th", "6th", "7th", "8th", "9th", "10th", "11th", "12th" };

    protected override void OnInitialized()
    {
        // Initialize with sample data
        courses = new List<Course>
        {
            new() { 
                Id = 1, 
                Name = "Algebra Fundamentals", 
                Description = "Introduction to algebraic concepts and problem-solving strategies.", 
                Subject = "Math", 
                GradeLevel = "8th", 
                StartDate = new DateTime(2024, 9, 1), 
                EndDate = new DateTime(2025, 6, 15), 
                IsActive = true, 
                CreatedAt = DateTime.Now.AddDays(-30),
                LessonPlans = new List<LessonPlan>
                {
                    new() { Id = 1, Title = "Introduction to Variables", Description = "Understanding variables and expressions", Objectives = "Students will identify variables and write simple expressions", Materials = "Whiteboard, markers, worksheets", Activities = "1. Review number concepts\n2. Introduce variables\n3. Practice problems", Assessment = "Worksheet completion", DurationMinutes = 45, WeekNumber = 1, DayNumber = 1, CourseId = 1 },
                    new() { Id = 2, Title = "Solving Linear Equations", Description = "Basic equation solving techniques", Objectives = "Students will solve simple linear equations", Materials = "Calculator, practice sheets", Activities = "1. Review variables\n2. Solve equations step by step\n3. Group practice", Assessment = "Quiz on equation solving", DurationMinutes = 60, WeekNumber = 1, DayNumber = 2, CourseId = 1 }
                }
            },
            new() { 
                Id = 2, 
                Name = "World History: Ancient Civilizations", 
                Description = "Exploration of ancient civilizations and their impact on modern society.", 
                Subject = "History", 
                GradeLevel = "6th", 
                StartDate = new DateTime(2024, 9, 1), 
                EndDate = new DateTime(2025, 6, 15), 
                IsActive = true, 
                CreatedAt = DateTime.Now.AddDays(-25),
                LessonPlans = new List<LessonPlan>
                {
                    new() { Id = 3, Title = "Introduction to Ancient Egypt", Description = "Overview of Egyptian civilization", Objectives = "Students will understand Egyptian geography and culture", Materials = "Maps, images, videos", Activities = "1. Map exploration\n2. Video presentation\n3. Discussion", Assessment = "Written summary", DurationMinutes = 50, WeekNumber = 1, DayNumber = 1, CourseId = 2 }
                }
            },
            new() { 
                Id = 3, 
                Name = "Creative Writing Workshop", 
                Description = "Developing writing skills through creative expression and storytelling.", 
                Subject = "Language Arts", 
                GradeLevel = "7th", 
                StartDate = new DateTime(2024, 9, 1), 
                EndDate = null, 
                IsActive = true, 
                CreatedAt = DateTime.Now.AddDays(-20),
                LessonPlans = new List<LessonPlan>()
            },
            new() { 
                Id = 4, 
                Name = "Biology: Cell Structure", 
                Description = "Study of cell biology and microscopic organisms.", 
                Subject = "Science", 
                GradeLevel = "9th", 
                StartDate = new DateTime(2024, 9, 1), 
                EndDate = new DateTime(2025, 1, 15), 
                IsActive = false, 
                CreatedAt = DateTime.Now.AddDays(-60),
                LessonPlans = new List<LessonPlan>()
            }
        };

        // Select first course by default
        if (courses.Any())
        {
            SelectCourse(courses.First());
        }
    }

    private IEnumerable<Course> filteredCourses => courses
        .Where(c => string.IsNullOrEmpty(searchTerm) || 
                   c.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                   c.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                   c.Subject.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(c => string.IsNullOrEmpty(selectedSubject) || c.Subject == selectedSubject)
        .Where(c => string.IsNullOrEmpty(selectedGradeLevel) || c.GradeLevel == selectedGradeLevel)
        .OrderBy(c => sortBy switch
        {
            "Name" => c.Name,
            "Subject" => c.Subject,
            "GradeLevel" => c.GradeLevel,
            "StartDate" => c.StartDate.ToString(),
            _ => c.Name
        })
        .ThenBy(c => sortDirection == "asc" ? c.Name : c.Name);

    private void SelectCourse(Course course)
    {
        selectedCourse = course;
    }

    private void SortByName() => SortBy("Name");
    private void SortBySubject() => SortBy("Subject");
    private void SortByGradeLevel() => SortBy("GradeLevel");
    private void SortByStartDate() => SortBy("StartDate");

    private void SortBy(string field)
    {
        if (sortBy == field)
        {
            sortDirection = sortDirection == "asc" ? "desc" : "asc";
        }
        else
        {
            sortBy = field;
            sortDirection = "asc";
        }
    }

    private void ToggleSortDirection()
    {
        sortDirection = sortDirection == "asc" ? "desc" : "asc";
    }

    private void ShowAddCourseModal()
    {
        newCourse = new Course { StartDate = DateTime.Today };
        showAddCourseModal = true;
    }

    private void CloseAddCourseModal()
    {
        showAddCourseModal = false;
    }

    private void AddCourse()
    {
        if (!string.IsNullOrEmpty(newCourse.Name))
        {
            newCourse.Id = courses.Max(c => c.Id) + 1;
            newCourse.CreatedAt = DateTime.Now;
            newCourse.LessonPlans = new List<LessonPlan>();
            newCourse.Assignments = new List<Assignment>();
            newCourse.Students = new List<Student>();
            courses.Add(newCourse);
            CloseAddCourseModal();
        }
    }

    private void ShowEditCourseModal(Course course)
    {
        // Implementation for editing course
        // In a real implementation, this would open a modal with the course's current data
        // For now, we'll just update the UI to show edit mode
        selectedCourse = course;
        StateHasChanged();
    }

    private void DeleteCourse(Course course)
    {
        courses.Remove(course);
        if (selectedCourse?.Id == course.Id)
        {
            selectedCourse = courses.FirstOrDefault();
        }
    }

    private void ShowAddLessonPlanModal()
    {
        if (selectedCourse != null)
        {
            newLessonPlan = new LessonPlan { CourseId = selectedCourse.Id };
            showAddLessonPlanModal = true;
        }
    }

    private void CloseAddLessonPlanModal()
    {
        showAddLessonPlanModal = false;
    }

    private void AddLessonPlan()
    {
        if (!string.IsNullOrEmpty(newLessonPlan.Title) && selectedCourse != null)
        {
            newLessonPlan.Id = selectedCourse.LessonPlans.Count > 0 ? 
                selectedCourse.LessonPlans.Max(lp => lp.Id) + 1 : 1;
            newLessonPlan.CreatedAt = DateTime.Now;
            selectedCourse.LessonPlans.Add(newLessonPlan);
            CloseAddLessonPlanModal();
        }
    }

    private void ViewLessonPlan(LessonPlan lessonPlan)
    {
        // Implementation for viewing lesson plan details
        // In a real implementation, this would open a modal or navigate to a detailed view
        // For now, we'll just update the UI to show the lesson plan details
        StateHasChanged();
    }

    private void EditLessonPlan(LessonPlan lessonPlan)
    {
        // Implementation for editing lesson plan
        // In a real implementation, this would open a modal with the lesson plan's current data
        // For now, we'll just update the UI to show edit mode
        StateHasChanged();
    }

    private void DeleteLessonPlan(LessonPlan lessonPlan)
    {
        if (selectedCourse != null)
        {
            selectedCourse.LessonPlans.Remove(lessonPlan);
        }
    }
} 